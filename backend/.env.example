# Copia este archivo como .env y llena tus datos. El .env no se sube al repositorio.
PUERTO=3200
ORIGEN_FRONT=http://localhost:4200

# MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=petrova_erp

# Firma del token de sesion (cualquier texto largo)
JWT_SECRETO=cambia-este-texto-por-uno-largo

# PayPal sandbox: https://developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API=https://api-m.sandbox.paypal.com

# Correo SMTP (Gmail con contrasena de aplicacion)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
